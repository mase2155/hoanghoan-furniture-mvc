<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - hoanghoan_furniture_devmaster</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/layout_admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/font.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="d-flex admin-wrapper">
        <!-- SIDEBAR -->
        <aside class="admin-sidebar d-flex flex-column justify-content-between">
            <div class="sidebar-top">
                <div class="sidebar-brand">
                    <i class="bi bi-list"></i>
                    <span class="brand-text">HoangHoan Dashboard</span>
                </div>
                <ul class="sidebar-menu">
                    <li class="menu-item">
                        <!-- Sử dụng Tag Helper asp-controller và asp-action để điều hướng chuẩn MVC -->
                        <a asp-controller="Dashboard" asp-action="Index" class="menu-link active">
                            <i class="bi bi-grid-fill"></i> Dashboard
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-footer">
                © Dinh Hung - Devmaster Academy
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <div class="admin-main flex-grow-1 d-flex flex-column">
            <!-- HEADER -->
            <header class="admin-header d-flex align-items-center justify-content-end px-4">
                <div class="user-profile d-flex align-items-center">
                    <span class="user-name">DinhHung</span>
                    <div class="user-avatar d-flex align-items-center justify-content-center">
                        <i class="bi bi-person-fill"></i>
                    </div>
                </div>
            </header>
            <main class="admin-content p-4 flex-grow-1">
                
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>